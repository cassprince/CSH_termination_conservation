library(BiocManager)
library(DESeq2)
library(readr)
library(tidyverse)
library(ggprism)
library(plotly)
library(readxl)
library(ggrepel)
library(ggmagnify)
# reading in output from featureCounts.
readCounts <- read.table("C:/Users/cassp/Box Sync/Feaga Lab/Cassidy Prince/prfB/Data/RNA_seq/combinedCounts.txt", header = TRUE)
head(readCounts)
#gene IDs should be stored as row.names
row.names(readCounts) <- gsub("-", ".", readCounts$Geneid)
# exclude columns without read counts (cols 1 to 6)
readCounts <- readCounts[,-c(1:6)]
head(readCounts)
# According to ?colData, we need a data.frame where the rows match the columns of count data
# This is extra information about the samples
# The design indicates how to model the samples
# See the attached file
sample_information <- read.csv("C:/Users/cassp/Box Sync/Feaga Lab/Cassidy Prince/prfB/Data/RNA_seq/sample_information.csv", row.names = 1, colClasses = c("character", "character", "character", "character"))
sample_information$strain <- as.factor(sample_information$strain)
sample_information$replicate <- as.factor(sample_information$replicate)
sample_information$induction <- as.factor(sample_information$induction)
sample_information
sample_filt = sample_information %>% filter(induction == "1")
View(sample_filt)
View(readCounts)
View(readCounts)
readCounts_filt = readCounts %>% select(contains("1xyl"))
# Run DESeq (it has some weird documentation)
# Cassidy's "design" will probably be as simple as "design = ~ strain"
dds <- DESeqDataSetFromMatrix(countData = readCounts_filt,
colData = sample_filt,
design = ~ replicate + induction)
# Run DESeq (it has some weird documentation)
# Cassidy's "design" will probably be as simple as "design = ~ strain"
dds <- DESeqDataSetFromMatrix(countData = readCounts_filt,
colData = sample_filt,
design = ~ replicate + strain)
dds <- DESeq(dds)
# visualize results in PCA
vsd <- vst(dds, blind = FALSE)
vsd
plotPCA(vsd, intgroup = c("strain","induction"))
plotDispEsts(dds)
subtiwiki = read_tsv("C:/Users/cassp/Box Sync/Feaga Lab/Cassidy Prince/Overlapping genes/subtiwiki_gene_list.tsv")
regulon = read_csv("C:/Users/cassp/Box Sync/Feaga Lab/Cassidy Prince/subtiwiki_regulons.csv")
sigB_reg = regulon %>%
filter(`regulator name` == "sigB")
# first look at the names of the results from your DESeq
resultsNames(dds)
# Then you can substitute the name parameter for the name of your results
# alpha is the pval cutoff for significance
summary(results(dds, name = "induction_1_vs_0", alpha = 0.05))
# Then you can substitute the name parameter for the name of your results
# alpha is the pval cutoff for significance
summary(results(dds, name = "strain_CP73_vs_CP215", alpha = 0.05))
# now to pull the results as a df
results_df1 <- results(dds, name = "strain_CP73_vs_CP215", alpha = 0.05) %>%
as.data.frame() %>%
mutate(genes = rownames(.))
results_df = left_join(results_df1, sigB_reg, by = join_by("genes" == "gene name")) %>%
left_join(select(subtiwiki, title, description), by = join_by("genes" == "title"))
# ggplot volcano plot
results_volcano <- results_df %>%
ggplot(aes(x = log2FoldChange, y = -log(padj), label = genes, fill = `regulator name`))+
geom_point(alpha = 0.5) +
ggtitle("title") +
geom_vline(xintercept = -1, linetype = 'dashed', color = "red") +
geom_vline(xintercept = 1, linetype = 'dashed', color = "red") +
geom_hline(yintercept = -log(0.05), linetype = 'dashed', color = "red")
# use ggplotly() to interact with your volcano
ggplotly(results_volcano)
View(results_df)
View(readCounts)
View(readCounts_filt)
colsums(readCounts_filt)
sum(readCounts_filt)
colSums(readCounts_filt)
